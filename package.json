{
  "name": "invest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily X-feed research corpus for a curated market-commentary allowlist.",
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0",
    "clean": "rm -rf dist node_modules",
    "task:resolve-accounts": "tsx --env-file-if-exists=.env src/pipeline/x/resolve-accounts.ts",
    "task:sync-universe": "tsx --env-file-if-exists=.env src/pipeline/lib/universe.ts",
    "task:capture": "tsx --env-file-if-exists=.env src/pipeline/capture/index.ts",
    "task:backfill": "tsx --env-file-if-exists=.env src/pipeline/capture/backfill.ts",
    "task:delta": "tsx --env-file-if-exists=.env src/pipeline/capture/backfill.ts --months 1",
    "task:normalize": "tsx --env-file-if-exists=.env src/pipeline/normalize/index.ts",
    "task:extract": "tsx --env-file-if-exists=.env src/pipeline/extract/index.ts",
    "task:session-dump": "tsx --env-file-if-exists=.env src/pipeline/extract/session/dump.ts",
    "task:session-ingest": "tsx --env-file-if-exists=.env src/pipeline/extract/session/ingest.ts",
    "task:enrich": "tsx --env-file-if-exists=.env src/pipeline/prices/index.ts",
    "task:render": "tsx --env-file-if-exists=.env src/pipeline/render/index.ts",
    "rebuild": "tsx --env-file-if-exists=.env src/pipeline/rebuild.ts",
    "repl": "tsx --env-file-if-exists=.env src/pipeline/duck/repl.ts",
    "q": "tsx --env-file-if-exists=.env src/pipeline/duck/q.ts",
    "agents": "tsx --env-file-if-exists=.env src/agent-sdk/src/cli.ts agents",
    "agents:check": "tsx --env-file-if-exists=.env src/agent-sdk/src/cli.ts check",
    "agents:list": "tsx --env-file-if-exists=.env src/agent-sdk/src/cli.ts list",
    "agents:shims": "tsx --env-file-if-exists=.env src/agent-sdk/src/cli.ts shims",
    "web": "tsx --env-file-if-exists=.env src/agent-sdk/src/cli.ts web"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@anthropic-ai/sdk": "^0.124.0",
    "@duckdb/node-api": "^1.5.5-r.4",
    "yaml": "^2.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "~4.1.11"
  }
}
